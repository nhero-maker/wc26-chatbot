# WC26 Chatbot — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in each value below with real credentials
#   3. Never commit .env.local — it is gitignored
#
# VERCEL DEPLOYMENT
#   Set each variable in: Vercel Dashboard → Project → Settings → Environment Variables
#   Required environments: Production, Preview, Development
#
# IF A SECRET IS COMPROMISED
#   1. Rotate the credential immediately (generate new secret, update n8n + Vercel)
#   2. Revoke all active sessions if needed (change N8N_PLAYER_SECRET)
#   3. See SECURITY.md for full rotation procedure
# ─────────────────────────────────────────────────────────────────────────────


# ── Chat Webhook ──────────────────────────────────────────────────────────────
# The n8n webhook URL for the AI chat assistant
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-chat-path

# Shared secret sent in x-wc26-secret header to authenticate app → n8n requests.
# Must match the value configured in your n8n webhook node.
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=replace-with-64-char-hex-secret


# ── Player Platform ───────────────────────────────────────────────────────────
# Base URL for n8n player/admin webhook endpoints (no trailing slash)
N8N_BASE_URL=https://your-instance.app.n8n.cloud/webhook

# Shared secret for player API routes (dashboard, rounds, leaderboards, admin).
# Generate with: openssl rand -hex 32
N8N_PLAYER_SECRET=replace-with-64-char-hex-secret


# ── Admin Access ──────────────────────────────────────────────────────────────
# Comma-separated emails that receive admin privileges on sign-in.
# Admin status is verified server-side and stored in an httpOnly cookie.
# Cannot be forged by clients. Revoke by removing the email and redeploying.
# Example: ADMIN_EMAILS=you@example.com,co-admin@example.com
ADMIN_EMAILS=your-admin-email@example.com

# Secret key used to HMAC-sign the admin cookie value.
# Prevents attackers from forging admin cookies even if they know their session token.
# Generate with: openssl rand -hex 32
# Rotating this value invalidates all active admin sessions (admins must sign in again).
ADMIN_COOKIE_SECRET=replace-with-64-char-hex-secret
