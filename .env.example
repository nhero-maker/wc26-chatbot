# WC26 Chatbot - Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local

# Chat webhook
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/wc26-chat
N8N_WEBHOOK_SECRET=your-64-char-hex-secret-here

# Player platform
N8N_BASE_URL=https://your-instance.app.n8n.cloud/webhook
N8N_PLAYER_SECRET=your-64-char-hex-secret-here
